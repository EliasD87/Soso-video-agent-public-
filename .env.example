# Keys for the Lark video bot. Copy this file to .env in the same folder (the repo root), then put
# each value right after "=" (no quotes, no spaces). .env is git-ignored: never commit it.

# Claude API: console.anthropic.com -> API Keys (starts with sk-ant-). Billed per use.
ANTHROPIC_API_KEY=

# ElevenLabs: elevenlabs.io -> your profile -> API Keys (needs Text to Speech access)
ELEVENLABS_API_KEY=

# Magnific: magnific.com -> API keys (REST API, header x-magnific-api-key)
MAGNIFIC_API_KEY=

# Your Lark custom app: open.larksuite.com/app -> your app -> Credentials & Basic Info
LARK_APP_ID=
LARK_APP_SECRET=
# lark = Lark international (open.larksuite.com), feishu = Feishu China (open.feishu.cn)
LARK_DOMAIN=lark

# Spending cap for one request in a thread, in US dollars. 0 = no cap.
MAX_USD_PER_JOB=0

# Remotion render workers: set it to the CPU cores the bot gets (BOT_CPUS at setup). Default 2.
RENDER_CONCURRENCY=2

# Optional: a second Lark app, for people in another organization (their own custom app).
# Any <NAME>_LARK_APP_ID / <NAME>_LARK_APP_SECRET / <NAME>_LARK_DOMAIN set adds one more.
PARTNER_LARK_APP_ID=
PARTNER_LARK_APP_SECRET=
PARTNER_LARK_DOMAIN=lark
